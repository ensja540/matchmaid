# Copy this file to ".env" and paste your Neon connection string after the =
# It looks like: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PORT=3000

# --- Web push (lock-screen alerts) -------------------------------------------
# Generate a pair once with:  npx web-push generate-vapid-keys
# The public key is safe to share (browsers get it from /api/push/key).
# The private key is a SECRET: Render dashboard only, never in code or git.
# Leave any of the three empty and push is switched off; email carries on as before.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Testing only: 1 shows the admin's own cleaner listing in public search so it
# can be messaged from a customer account. Remove when finished.
SHOW_ADMIN_LISTING=
